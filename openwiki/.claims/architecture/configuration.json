        }
      ]
    },
    {
      "id": "claim_24e9d07105af4232aa5f8077586e860e",
      "statement": "The configured model is always inserted into available_models when absent, because otherwise the UI would show a current value that could not be selected again after switching away from it.",
      "evidence": [
        {
          "resource": "repo://server/agent/config/settings.py#L128-L150",
          "version": "repo-lines-v1:sha256:dcabb11a7599dcf9d29eed495797b92118207fc085edc421edf0e98d16f92d23:"
