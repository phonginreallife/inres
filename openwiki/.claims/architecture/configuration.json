    },
    {
      "id": "claim_0140d9a108e84441b689efb44be12d98",
      "statement": "Supabase is addressed through distinct URL settings for distinct consumers: supabase_url for internal API-to-Supabase calls, public_supabase_url for the browser (proxied through nginx under HTTPS), and mobile_supabase_url for mobile clients.",
      "evidence": [
