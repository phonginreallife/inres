        }
      ]
    },
    {
      "id": "claim_cd567a0f34df440aae2c389c6cf9c7ac",
      "statement": "Numeric agent settings are parsed defensively: a malformed environment value is caught, logged with the offending variable name, and replaced with the default rather than raising at import time.",
      "evidence": [
        {
          "resource": "repo://server/agent/config/settings.py#L160-L175",
          "version": "repo-lines-v1:sha256:edf2107aa9eef62adb2bade61b9a3d5ef278474bea267327490f1ec627d7d418:"
        }
      ]
    },
    {
      "id": "claim_4e5f429f029a4317a8b34b28f616d1cb",
      "statement": "available_models is an allowlist rather than a suggestion — a model arriving over the WebSocket is checked against it before reaching the CLI, so a crafted message cannot select an arbitrary model the credential could otherwise reach.",
      "evidence": [
        {
          "resource": "repo://server/agent/config/settings.py#L120-L126",
          "version": "repo-lines-v1:sha256:acc0f4d2e88d630e13f67efc51c8dc10c9d8ce0d2861e7e01e4999cc45c92e09:"
