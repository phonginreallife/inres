        }
      ]
    },
    {
      "id": "claim_f55554b6d5dc4ac98d3ed948efaea54e",
      "statement": "The YAML carries two distinct AI configuration blocks with separate environment prefixes: ai_incident_analytics drives the background PGMQ-driven incident analysis and ai_agent drives the interactive chat agent.",
      "evidence": [
        {
          "resource": "repo://deploy/docker/volumes/config/cfg.ex.yaml#L66-L95",
          "version": "repo-lines-v1:sha256:0284ce7c1f33071aa273d6c26dfe241c765a303da424f70421c9c5758e8f68f4:"
