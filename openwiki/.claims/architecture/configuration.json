    },
    {
      "id": "claim_10a693d2aff140f3b963e10de58fe513",
      "statement": "max_concurrent_cli caps live CLI subprocesses at one per active chat session, bounding agent memory under many open tabs, and the configuration documents raising it only alongside the container memory limit.",
      "evidence": [
        {
          "resource": "repo://deploy/docker/volumes/config/cfg.ex.yaml#L112-L116",
          "version": "repo-lines-v1:sha256:5dc6c5ca5000ac5df74f8f34738f44037da37d8c122ff1d6261cb419f232f43e:"
        },
        {
          "resource": "repo://server/agent/config/settings.py#L113-L118",
          "version": "repo-lines-v1:sha256:5f06920b40e99e4de390c5bbca6109e80ef2620480a03ab69bd535557504f7af:"
        }
      ]
    },
    {
      "id": "claim_3afbe91b31db4387b178bd01e2f28410",
      "statement": "The agent's idle_timeout_s drops the CLI subprocess after a period without traffic while retaining the session id, so the next message resumes the conversation rather than starting over.",
      "evidence": [
        {
          "resource": "repo://deploy/docker/volumes/config/cfg.ex.yaml#L106-L110",
          "version": "repo-lines-v1:sha256:4a3ef79fab6a977f3a912d26de3e90cf8aa7dd3c2bcf4fb9a5d8e2de4b7b3ab3:"
