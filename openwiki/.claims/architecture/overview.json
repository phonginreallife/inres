    {
      "id": "claim_19eb1abef96d4ae2845056cb1b288ce7",
      "statement": "InRes services integrate through shared Postgres tables and PGMQ queues rather than direct RPC between processes, so a producer enqueues durable work and an independent consumer polls and acts on it.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/notification.go#L60-L106",
