        }
      ]
    },
    {
      "id": "claim_70bf10d14e204282b90a072bceca7616",
      "statement": "The API process installs a LightweightNotificationSender that only enqueues notifications to PGMQ without processing them, so the HTTP request path never blocks on Slack or push delivery.",
