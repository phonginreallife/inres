        }
      ]
    },
    {
      "id": "claim_7a26cc6c9b2449da9ce5b823e33fbd04",
      "statement": "The Go API server starts the notification worker and the incident escalation worker as in-process goroutines while a separate worker binary starts the same two workers standalone, so a single-container deployment gets escalation with no extra orchestration and a larger deployment can scale the workers independently.",
      "evidence": [
        {
          "resource": "repo://server/api/cmd/server/main.go#L98-L130",
          "version": "repo-lines-v1:sha256:17399903823feafb5a1ca1f47c7d9f8810ce297d82824a344ad2c1aa32089913:"
