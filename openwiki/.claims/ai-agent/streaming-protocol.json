          "version": "repo-lines-v1:sha256:5f4c4b70cc1aa58499932eb3f13790766c9b383fd0ecbcd30c90a9db618fd3dd:"
        }
      ]
    },
    {
      "id": "claim_540b81382a0f446f947d16e07d3b47f6",
      "statement": "StreamEvent deltas and the AssistantMessage that follows carry the same text, so the translator streams the deltas, treats the AssistantMessage as authoritative, and emits only the difference between them.",
