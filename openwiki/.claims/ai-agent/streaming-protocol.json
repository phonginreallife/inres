  "claims": [
    {
      "id": "claim_5a90eafd445544efbc77cc650edacc29",
      "statement": "translate() is a pure function over the SDK message stream and a mutable TurnState with no I/O, no SDK client and no asyncio, so every stream-handling decision can be tested exhaustively against synthetic message sequences.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/translate.py#L1-L10",
          "version": "repo-lines-v1:sha256:c320b49cd18e5b3af55d1577c1a8ec5eb197f6b1ee75d24f9e65aca13ba87128:"
        },
        {
