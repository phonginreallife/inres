          "version": "repo-lines-v1:sha256:98a360f06973c744bbacd94c6300417897895188e130270ed44018529ff9a2a9:"
        }
      ]
    },
    {
      "id": "claim_34b25d123e6f405eaed88f6788e33c31",
      "statement": "An unrecognised SDK message type is logged and ignored rather than failing the turn, and a translation exception is caught and yields no events, because the CLI may introduce new message types in a version bump.",
