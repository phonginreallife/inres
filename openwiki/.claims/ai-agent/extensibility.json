  "claims": [
    {
      "id": "claim_631b75c67d6640769bdf85210f88f5c8",
      "statement": "The agent's incident tools run in-process as an SDK MCP server created by create_sdk_mcp_server() rather than as an MCP subprocess, and are seeded unconditionally into every session's mcp_servers map before user-configured servers are merged on top.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/config.py#L144-L148",
          "version": "repo-lines-v1:sha256:1f34d3972c388e318a3560470f4ac055e85fe28cd40a39f79b9ea5b3e2a9f83a:"
        },
        {
          "resource": "repo://server/agent/tools/incidents.py#L759-L791",
          "version": "repo-lines-v1:sha256:1ec22a023c18e170a6b29c793d92c6efc287c8e6e7cdd00a31a26c09216a0704:"
        }
      ]
    },
    {
      "id": "claim_0c5123f1fea54827a8d954078fe8e2d9",
      "statement": "Because the incident tools run in-process without an MCP handshake to carry identity, the module holds the caller's auth token, org id and project id in module-level state populated through explicit setters per connection.",
      "evidence": [
        {
          "resource": "repo://server/agent/tools/incidents.py#L27-L94",
          "version": "repo-lines-v1:sha256:e16872d4aec46bcc0d52b7a698c3e86f5c76da271358862532596a10c7b4ccd8:"
        }
      ]
    },
    {
      "id": "claim_91aa0e83d3ca499a8f5e127a605de4d5",
      "statement": "Per-user MCP server definitions are read from the PostgreSQL user_mcp_servers table filtered to status = 'active', not from object storage, and each row is shaped by its server_type into either a stdio {command,args,env} config or a URL-based {type,url,headers} config, with unknown types skipped.",
      "evidence": [
        {
          "resource": "repo://server/agent/services/storage.py#L397-L494",
          "version": "repo-lines-v1:sha256:59f95268256df56300fa9fb050562986bbd2029e0ee188297dd2dd95049f1c4a:"
        }
      ]
    },
    {
      "id": "claim_f64fde7495a74ab48d2df78b5e239ac9",
      "statement": "get_user_mcp_servers accepts either an auth_token or a direct user_id with user_id taking priority, so the JWT WebSocket and the zero-trust WebSocket can both resolve a user's MCP servers despite the zero-trust path having no JWT.",
      "evidence": [
        {
          "resource": "repo://server/agent/services/storage.py#L397-L455",
          "version": "repo-lines-v1:sha256:0226f898d00461cb784694a3f34d65607b2dfbfd457aab4c9f8ad4c4c0e66264:"
        }
      ]
    },
    {
      "id": "claim_fd26d8b8b6434c86a10c8dd6114214e3",
      "statement": "A failure to load a user's MCP servers is caught and returns an empty dict, so a broken MCP configuration degrades the agent to its built-in tools instead of failing the WebSocket connection.",
      "evidence": [
        {
          "resource": "repo://server/agent/services/storage.py#L487-L494",
          "version": "repo-lines-v1:sha256:9265086daaa32e8f08e7b30da9e21806baeb91f2730321e9ad4fe7c7fbf63783:"
        }
      ]
    },
    {
      "id": "claim_786137793f7c46f68916a006d0395f9f",
      "statement": "normalize_mcp_servers strips non-schema keys such as the 'tools' annotation added by MCPToolManager.get_server_configs(), tags stdio servers explicitly, defaults URL-based servers to http, and skips entries having neither a command nor a url, because the CLI rejects or ignores configs carrying extra keys.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/config.py#L82-L115",
          "version": "repo-lines-v1:sha256:d1e65c88b625bfa0e96d822ce3e16c18cff2bcc496ec1bfa822aaf4e2c6fdbb3:"
        }
      ]
    },
    {
      "id": "claim_be0feebbe3bc445e823f88795a40ecf1",
      "statement": "MCPServerPool is an async singleton whose creation is guarded by a class-level asyncio lock, and it tracks live clients, per-server referencing user ids, per-server last-access times, and a reverse user-to-server index.",
      "evidence": [
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L412-L452",
          "version": "repo-lines-v1:sha256:816138bb8fac8c878ea89ff345d108443e1e77b523efc764870f15cc9bd1ed2c:"
        }
      ]
    },
    {
      "id": "claim_c99bbee2671449598dca660d115d7f8d",
      "statement": "Pooled MCP servers are keyed by the server configuration itself — command plus sorted args plus sorted env — so identical configurations share one subprocess while any difference such as a distinct credential in env produces a separate process and prevents cross-tenant reuse.",
      "evidence": [
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L487-L495",
          "version": "repo-lines-v1:sha256:255212edd8df509db58558688488c0d56eb8d870ae2ce61ced8835cde96049e9:"
        },
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L525-L560",
          "version": "repo-lines-v1:sha256:95a2d75a0c2d714ed69b70184e2441038b96fe890b2e0d74a46bb3532271562e:"
        }
      ]
    },
    {
      "id": "claim_4d107f0dd1394984b0c98cd87db5204e",
      "statement": "Releasing a user's pooled MCP servers only discards the reference and stamps the last-access time; it never stops the subprocess, leaving the server warm for the next session requesting the same configuration.",
      "evidence": [
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L570-L582",
          "version": "repo-lines-v1:sha256:09d0b6bbc4e24e9d1793c33d7927e2d435a56a4dbbff23b45495342ee2e0ef1a:"
        }
      ]
    },
    {
      "id": "claim_0e9301e26ad344c99d51e3d3eb10a641",
      "statement": "A background cleanup loop runs every 60 seconds and stops a pooled MCP server only when both its idle time exceeds MCP_SERVER_IDLE_TIMEOUT (300 seconds by default) and its reference set is empty, so an actively referenced server is never reaped.",
      "evidence": [
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L31-L33",
          "version": "repo-lines-v1:sha256:3527b300deef95e958ff39f6683a378041648e12638c73e776b5fbdf8238a174:"
        },
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L454-L486",
          "version": "repo-lines-v1:sha256:94576e5330571d86b70d1f10484d2f2b395f415a3629314035bc4f8ca2ae7314:"
        }
      ]
    },
    {
      "id": "claim_e3acaf4318ff4905a3a13d18ff2b7622",
      "statement": "MCP server startup is bounded by MAX_MCP_SERVERS_PER_USER (default 5) and MAX_GLOBAL_MCP_SERVERS (default 50); hitting either limit logs a warning and stops starting further servers while still returning the manager, so the session proceeds with partial tooling rather than failing.",
      "evidence": [
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L31-L33",
          "version": "repo-lines-v1:sha256:3527b300deef95e958ff39f6683a378041648e12638c73e776b5fbdf8238a174:"
        },
        {
          "resource": "repo://server/agent/streaming/mcp_client.py#L519-L568",
          "version": "repo-lines-v1:sha256:26477ce1932c8b10fc03719d21e4ce708241e83666cf18f8238658a3b3886b6b:"
        }
      ]
    },
    {
      "id": "claim_ed765dec2e654bee86d1c26e33f01c57",
      "statement": "MCPConfigManager maintains a TTL cache of per-user MCP configuration, writes it as .mcp.json into the user's workspace, and re-syncs explicitly registered users on a background loop governed by MCP_SYNC_INTERVAL (60 seconds by default).",
      "evidence": [
        {
          "resource": "repo://server/agent/streaming/mcp_config.py#L255-L336",
          "version": "repo-lines-v1:sha256:a4774f8a70238f1a1f8382fc2c6fe300389ef86f4366a799bbbaaefa7c81bfd0:"
        },
        {
          "resource": "repo://server/agent/streaming/mcp_config.py#L26-L110",
          "version": "repo-lines-v1:sha256:213b3e5dfe9a46db3df1d9cd900c683696d0624b40d4424319a482c3666d1888:"
        }
      ]
    },
    {
      "id": "claim_3987e22197fa4d28b0a12483a3e7465d",
      "statement": "Marketplaces are distributed by git clone and incremental git fetch rather than by ZIP archives in object storage, which was adopted because incremental updates are faster, no archives need to be stored in S3, and versioning uses native git tooling.",
      "evidence": [
        {
          "resource": "repo://server/agent/routes/marketplace.py#L526-L546",
          "version": "repo-lines-v1:sha256:45bc39d7d15fe446dd864f6fd8a80496e1a6da44e406f07f2cfa86cb2a7eec39:"
        },
        {
          "resource": "repo://server/agent/routes/marketplace.py#L691-L706",
          "version": "repo-lines-v1:sha256:7a2da92f5a9e2dde1cc0a88fabfb8255eda2c38aa975333654cafe4c6756c36b:"
        }
      ]
    },
    {
      "id": "claim_245bd72ec7ee45c1a03372067d6e5239",
      "statement": "The marketplace update route verifies the target directory is a git repository before fetching and refuses with an instruction to re-clone when it is not, which is how directories left over from the ZIP-era distribution are detected.",
      "evidence": [
        {
          "resource": "repo://server/agent/routes/marketplace.py#L748-L760",
          "version": "repo-lines-v1:sha256:9ad34f721eadcd468dfa5a1e41e14fafbdb34483d5e8a11e6fc8fd2773ae290b:"
        }
      ]
    },
    {
      "id": "claim_e0dd282223e64b18a0acc27b63137f94",
      "statement": "Marketplace names are validated against ^[A-Za-z0-9_.-]+$ before being used to build filesystem paths, preventing user-supplied names from traversing outside the user's workspace directory.",
