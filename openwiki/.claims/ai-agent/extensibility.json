        }
      ]
    },
    {
      "id": "claim_1928e0c966d04053bb500b0de9e40fad",
      "statement": "Skills are synced from a per-user Supabase Storage bucket into the workspace using the same .claude/skills/ relative path at both ends, so the agent discovers them without further configuration.",
