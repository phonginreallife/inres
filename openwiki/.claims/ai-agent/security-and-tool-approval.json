  "claims": [
    {
      "id": "claim_06545400324e4ff8b18c2df1c3978b4a",
      "statement": "PermissionBroker mediates tool approval by minting a request id, creating a future, emitting a permission_request event to the output queue, and awaiting the future, which the WebSocket receive loop resolves when the user answers.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L142-L175",
          "version": "repo-lines-v1:sha256:ca0e8edce47c14d00d3c732abfe3c7b1d3076ce525a5f7e99e07a6f0a0e7503b:"
        }
      ]
    },
    {
      "id": "claim_8d75c10777ed40b68dcf81b49ea2fb99",
      "statement": "Every tool denial path uses interrupt=False so the model can explain itself or take another route rather than having the turn killed outright.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L145-L195",
          "version": "repo-lines-v1:sha256:f3a23291aa70e399b0f777210adcac82bf2bc22a749cc963012b9d21fae4a377:"
        }
      ]
    },
    {
      "id": "claim_941994da49a24d21ade674c83d65b492",
      "statement": "An unanswered approval request times out after the configured permission timeout, emits a permission_timeout event to clear the UI prompt, and returns a denial telling the model no user response arrived.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L172-L189",
          "version": "repo-lines-v1:sha256:a226bafb7f9bd75e5c7d077e76055c7723f7c2726190db8971eee58139d589fa:"
        }
      ]
    },
    {
      "id": "claim_d21060c2d048402b9c89e1dbe8789dd3",
      "statement": "Approval round trips are deadlock-free because nothing the SDK owns feeds the ASGI receive channel, so the wait graph among the SDK reader task, session runner, sender task and WebSocket receive loop stays acyclic and the receive loop can always read the response that breaks the cycle.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L1-L37",
          "version": "repo-lines-v1:sha256:e08857ea880efedd37bc0eabab999ebfb25821adffa03b71a73231a73fe7d8a6:"
        }
      ]
    },
    {
      "id": "claim_e01d4cb527374f728bcf0460fd6cdc7a",
      "statement": "ChatSession.interrupt() calls broker.deny_all() before invoking the SDK's interrupt(), because awaiting an SDK control call while an approval is pending would wait on a reader task that is itself parked inside the permission callback.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L20-L26",
          "version": "repo-lines-v1:sha256:a7dd07b69778619acdc93fc8d3204af726ac3a99802bfb823ea7f30a5017bf21:"
        },
        {
          "resource": "repo://server/agent/session/session.py#L178-L204",
          "version": "repo-lines-v1:sha256:e686b0632dbe10babcd21d432bb0867c68dd1c6758e3715cab877f2bc67a738c:"
        }
      ]
    },
    {
      "id": "claim_689802f5876140e7bead3d3c7786c759",
      "statement": "The permission output queue is deliberately unbounded and the pending future is deliberately unshielded, because a stalled bounded queue would block the request before transmission and a shielded future would prevent cancellation from propagating during shutdown.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L26-L37",
          "version": "repo-lines-v1:sha256:5a68eb0a4def5b937ce5710aa3c839429dea8cac3c05e60bf5dde0c53010e1db:"
        }
      ]
    },
    {
      "id": "claim_42ffd04547f441ec84213426a341ec71",
      "statement": "resolve() and deny_all() are synchronous rather than coroutines so the WebSocket receive loop never blocks while holding the only means of answering a pending approval.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L196-L234",
          "version": "repo-lines-v1:sha256:f3ae65c9d16eada2d820021bb6ced5ea8685309b2910db3104904d7e7c423730:"
        },
        {
          "resource": "repo://server/agent/session/permissions.py#L34-L37",
          "version": "repo-lines-v1:sha256:e8a65ab5bdf9b8689f19c34a8b23e0c0155548dfaf0a97198117306dbcfec187:"
        }
      ]
    },
    {
      "id": "claim_46eea96d66cd40e5bdd2ce4b3af27560",
      "statement": "Shutdown resolves outstanding approval futures as denied rather than cancelling them, because a cancelled callback can leave the CLI awaiting a control response that never arrives and make disconnect() hang until its own timeout.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L212-L234",
          "version": "repo-lines-v1:sha256:28327703e0949a67740840f6b52ff9611713fc5c6d9d3c2fe1dab73f5321a517:"
        }
      ]
    },
    {
      "id": "claim_0339c22210694348a74cb79d4d1d9381",
      "statement": "An allowlist consulted before any round trip lets pre-approved tool invocations run immediately, using Claude Code's pattern syntax of a bare tool name, a prefix match ending in :*, or an exact argument match.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L144-L148",
          "version": "repo-lines-v1:sha256:7ec28a1c0c40a620f6615ae540d277df28a207dd3121bb246376158eb3ea91ba:"
        },
        {
          "resource": "repo://server/agent/session/permissions.py#L76-L110",
          "version": "repo-lines-v1:sha256:7e3886c13779591d52a55d3092e3cff95ee30b9095320706af15bbddd79793a6:"
        }
      ]
    },
    {
      "id": "claim_ea00826c4f90448b9539c261c7d61caa",
      "statement": "Allowlist prefix matching resolves which argument describes a tool's action through a per-tool map (command for Bash, file_path for Read/Write/Edit, pattern for Grep/Glob, url for WebFetch), falling back to the first string value in the input and to an empty string for non-dict input.",
      "evidence": [
        {
          "resource": "repo://server/agent/session/permissions.py#L50-L74",
          "version": "repo-lines-v1:sha256:43d47dc59353d31b128e00938d20a547d7e3c9ad3557d95b377a3a4c26046aa3:"
        }
      ]
    },
    {
      "id": "claim_2d0310ccc18041edae750406eda394e6",
      "statement": "The permission test suite pins the invariants the deadlock argument relies on, including that denial does not kill the turn, that late or unknown or duplicate resolutions are rejected, that deny_all and close release waiters, and that cancelling a waiter leaks no pending entry.",
      "evidence": [
        {
          "resource": "repo://server/agent/tests/test_permissions.py#L43-L170",
          "version": "repo-lines-v1:sha256:84930779ed1c750de604388fb1da46f05afead7b72eb480fc731bed94300c5d6:"
        }
      ]
    },
    {
      "id": "claim_96697d322eeb46a4bb9476230fecf9d4",
      "statement": "The zero-trust socket uses two key layers: an instance-held ECDSA P-256 key that signs device certificates binding a device public key to a user, instance, permission list and expiry; and a device-held Ed25519 key that signs every individual message.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L366-L412",
          "version": "repo-lines-v1:sha256:ea3a1dc2e2cd420cae0d596199855c4fe6f87517039a2408ed84a1685c759cee:"
        },
        {
          "resource": "repo://server/agent/security/verifier.py#L50-L96",
          "version": "repo-lines-v1:sha256:fb83add70a5234c7968e2ad9e41bac61a504621f5e54b4d5236928d8c2821668:"
        },
        {
          "resource": "repo://server/agent/security/verifier.py#L536-L556",
          "version": "repo-lines-v1:sha256:a16ec2b8bee210d7b9f7e01bad3e42bbf6ef3663111fae1086f25129208e9fa7:"
        }
      ]
    },
    {
      "id": "claim_86e9e00e6c6e4e09a0bdce07021e6918",
      "statement": "Certificate verification converts the Go issuer's raw R||S 64-byte ECDSA signature into DER with encode_dss_signature before verifying, because the Python cryptography library does not accept the raw format the Go signer emits.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L379-L405",
          "version": "repo-lines-v1:sha256:ab37c23951b04ae464bdeaa1137d815f442e1e4d7c54bf11c202a75f3400e57f:"
        }
      ]
    },
    {
      "id": "claim_372f988b683a4815ad700e1ac960c1a7",
      "statement": "Every message on the zero-trust socket must pass session resolution, payload/signature presence, certificate-id match, a 60-second timestamp window, nonce presence, a database nonce-reuse check, Ed25519 signature verification, and a per-message-type permission check before it is accepted.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L45-L48",
          "version": "repo-lines-v1:sha256:8940717d3d2ba3376e016f53b0330e12add55f5e320ff7a55db9d1c30cc7db90:"
        },
        {
          "resource": "repo://server/agent/security/verifier.py#L491-L569",
          "version": "repo-lines-v1:sha256:17bbfcbde63ea189b044514d4c5e1d39c85fee7f3eadeecd93a2744e9953640c:"
        }
      ]
    },
    {
      "id": "claim_ace40c1988804f71bf5af28353f42c05",
      "statement": "A nonce is persisted only after the message signature verifies, so a message that fails verification cannot consume a nonce.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L536-L560",
          "version": "repo-lines-v1:sha256:3820fc10d8c7544c6ec3d7ceb60877cb9409fe5b0ed559c0e52cdf95be2f9436:"
        }
      ]
    },
    {
      "id": "claim_f57835f598c84426a40f0817f6c08af2",
      "statement": "Signed payloads are canonicalized as JSON with sorted keys, no separators whitespace and ensure_ascii=False, because ensure_ascii=False is required to match Dart's jsonEncode on the mobile client and non-ASCII text would otherwise serialize differently and fail every signature check.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L636-L647",
          "version": "repo-lines-v1:sha256:fa5f7df1e72dcf216f6db56ba7bb089d606c90cea880af0c324a868426d17a54:"
        }
      ]
    },
    {
      "id": "claim_663a34a305f541baaebcf354e98586f8",
      "statement": "Zero-trust sessions, nonces and instance public keys are persisted in PostgreSQL with in-memory caches treated only as a performance optimization, so replay protection and live sessions survive an agent process restart.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L107-L127",
          "version": "repo-lines-v1:sha256:68b9349de5d3a48ac8145848e54209b1290c74be6ceea2312c258e25097e3042:"
        },
        {
          "resource": "repo://server/agent/security/verifier.py#L172-L260",
          "version": "repo-lines-v1:sha256:9d8ca57c811489d671f0a183444cd4e3770188ebcf5068d3bb3f40530a5ea19a:"
        }
      ]
    },
    {
      "id": "claim_b9182d0c2207493a93f6c933fbce927b",
      "statement": "Verified sessions are given a 7-day expiry that deliberately exceeds certificate lifetime, and revocation deactivates the database row rather than only evicting the cache entry.",
      "evidence": [
        {
          "resource": "repo://server/agent/security/verifier.py#L48-L48",
          "version": "repo-lines-v1:sha256:2287ce39fc2210faf6e923a9d8d606c37ce6e5c04343afd8bffcbc359666a136:"
        },
        {
          "resource": "repo://server/agent/security/verifier.py#L584-L601",
          "version": "repo-lines-v1:sha256:5247d86ffc0ce7011d84520d5c13b95e106f769ba3422208f3da5d5d181caf66:"
        }
      ]
    },
    {
      "id": "claim_ed1c415f299b4b4ba3add38dc328365c",
      "statement": "Audit events are named category.action in AWS CloudTrail style across four categories — session, chat, tool and security — and each carries a success, failure or pending outcome status.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L51-L104",
          "version": "repo-lines-v1:sha256:ddc8a8ef7b51474ae5e85168fe409a606266a25b5c38fed10b9da88377163013:"
        }
      ]
    },
    {
      "id": "claim_82085c3e38cc49ab8babf643ee1943b0",
      "statement": "Tool execution is audited through the Claude Agent SDK hook system, with PreToolUse storing timing and input keyed by tool_use_id for PostToolUse to correlate, while tool request, approval and denial events are logged from the permission callbacks because hooks fire only after permission is granted.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/hooks.py#L1-L60",
          "version": "repo-lines-v1:sha256:d95a5b77f3433aa5991d336cdcb538999f7f2a34e36d1a18ee36a699766f40e7:"
        }
      ]
    },
    {
      "id": "claim_44ace62088a34746bd813455347ea4d0",
      "statement": "DataSanitizer redacts on two axes before events are queued: sensitive key names are replaced with a length-preserving [REDACTED:n chars] marker, and regex patterns replace JWT bearer tokens, sk- API keys, GitHub PATs, Slack tokens and email addresses in string values.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L198-L283",
          "version": "repo-lines-v1:sha256:e03a62b7ebad35b117f652122d4730940182e304a62b2b47ee0d50d864f89eb1:"
        },
        {
          "resource": "repo://server/agent/audit/service.py#L385-L400",
          "version": "repo-lines-v1:sha256:790584dee2f5219fb7d18d356f7a19d3a30644e325a62593753d4b267a72911f:"
        }
      ]
    },
    {
      "id": "claim_4f747c39150446f2a417b48ab3e75fd2",
      "statement": "Sanitization is depth-bounded to 10 levels and truncates strings longer than 10000 characters while recording the original length, so a deeply nested or huge payload cannot exhaust the audit path.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L224-L234",
          "version": "repo-lines-v1:sha256:1ded883fe1868391fdcf3a373560506cd1947dabee6c394703c05c436cf20b07:"
        },
        {
          "resource": "repo://server/agent/audit/service.py#L272-L283",
          "version": "repo-lines-v1:sha256:c936fe123311c409089d456f96cc18ce9da52e29dcc0f1378d6c729ff6b714e7:"
        }
      ]
    },
    {
      "id": "claim_fa5a30b543d24b39ade6dfd9dc9cc46e",
      "statement": "Shell-shaped tools receive additional sanitization that redacts inline credentials such as --password, -p, PGPASSWORD and AWS_SECRET_ACCESS_KEY inside the command string, which key-based redaction alone would not catch.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L285-L309",
          "version": "repo-lines-v1:sha256:4dfac2a1fb5f6214ae92936d7d8e1637c382f7252f5772f5a63390af21cf6911:"
        }
      ]
    },
    {
      "id": "claim_15ee3d65dcae464bade3b86e46e2751e",
      "statement": "AuditService keeps database writes off the request path by queueing events to a bounded asyncio queue and flushing a buffered batch when either the batch size (50) or the flush interval (5 seconds) is reached.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L312-L353",
          "version": "repo-lines-v1:sha256:492fff94d949025c6f330a69e5429a8ed2f4b8888f8f9a489106078bcd7418fe:"
        },
        {
          "resource": "repo://server/agent/audit/service.py#L420-L451",
          "version": "repo-lines-v1:sha256:0166c5a6657972f95db24b6504cfae05f6ad5293bee63601204499157aefc4b4:"
        }
      ]
    },
    {
      "id": "claim_7e609eacf7ae424393d9a144648e1fe5",
      "statement": "A failed audit flush re-buffers events for retry only while the buffer is below half the maximum queue size and otherwise counts them as dropped, so audit logging degrades under sustained database failure instead of exhausting memory.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L452-L475",
          "version": "repo-lines-v1:sha256:b4813f83c701b6c7434257c9c77805dc820541f2be4ab9d1c57261c2321465bc:"
        }
      ]
    },
    {
      "id": "claim_4c9388ab328c442385f4c5b8f6183672",
      "statement": "Stopping the audit service flushes the remaining buffer before cancelling the background worker, so an orderly shutdown does not lose queued events.",
      "evidence": [
        {
          "resource": "repo://server/agent/audit/service.py#L366-L383",
          "version": "repo-lines-v1:sha256:a04811060dab35a4468f754308f8098d9b7a3b5a7d4bb91c10d4c5198e0e84e5:"
        }
      ]
    }
