    {
      "id": "claim_f40344e23fdb450dab2014f36776b453",
      "statement": "A model switch requested mid-turn is deferred to the next turn boundary rather than awaited, because client.set_model() awaits a control response that only the SDK reader task can deliver and that task may be parked inside a pending tool approval.",
