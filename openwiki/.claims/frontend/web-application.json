    {
      "id": "claim_9b45e51bcd6a4624b306e60cc130e084",
      "statement": "The root layout nests providers in a dependency order where OrgProvider sits inside AuthProvider because it requires a session to fetch organizations, and NotificationProvider sits inside OrgProvider because its realtime subscription is scoped to the current organization.",
      "evidence": [
        {
          "resource": "repo://frontend/inres/src/app/layout.js#L42-L70",
          "version": "repo-lines-v1:sha256:c1b0280175f19d468154158e86bb0c33980e5cc0659cde43df23af6ae18dbbe1:"
        },
        {
