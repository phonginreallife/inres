        }
      ]
    },
    {
      "id": "claim_f575e36b64d44fb4a18f44a45380bbaf",
      "statement": "The frontend fetches its Supabase URL and anon key at runtime from the API's /env endpoint rather than from build-time environment variables, falling back to NEXT_PUBLIC_ variables only when that call fails, which lets one prebuilt image serve different Supabase projects without rebuilding.",
      "evidence": [
        {
          "resource": "repo://frontend/inres/src/lib/supabase.js#L1-L33",
          "version": "repo-lines-v1:sha256:27aff57564c9fe44408c9a7fd95901814f965caaac936fa04bb042e19976b928:"
        }
      ]
    },
    {
      "id": "claim_7fd25b098e2d44459cf213a3da757c98",
      "statement": "The Supabase client is a guarded singleton that deduplicates concurrent configuration fetches with a shared promise, makes late callers wait on an initializing flag, and re-checks the instance after awaiting, so a page never constructs two clients with duplicate auth listeners.",
      "evidence": [
        {
          "resource": "repo://frontend/inres/src/lib/supabase.js#L1-L60",
          "version": "repo-lines-v1:sha256:f7925e6f37f50abba7f409c9bfcce507a72b10b0a163291fd50e1e04cedeafb2:"
        }
      ]
    },
    {
      "id": "claim_ab03ae96ea7840e685e7ad78cc6f6563",
      "statement": "AuthContext validates a restored session by fetching the user and clears it from storage when invalid, explicitly handling stale-token errors such as a bad session_id claim that a mere presence check would miss.",
      "evidence": [
        {
          "resource": "repo://frontend/inres/src/contexts/AuthContext.tsx#L80-L124",
