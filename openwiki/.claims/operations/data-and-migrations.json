    {
      "id": "claim_963b995a783b432fb4dbe8dafa0b4789",
      "statement": "Row-level security for organization isolation is built on three SECURITY DEFINER STABLE helper functions that resolve the current user's organizations, projects and org access from the memberships table.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251202172650_add_rls_policies_for_org_isolation.sql#L5-L59",
          "version": "repo-lines-v1:sha256:13a6ad92f86f7a955598fe59519946cb3ffd77e5bf0e8d2de97ae6136c5d0f4e:"
        }
      ]
    },
    {
      "id": "claim_18ab767a26eb4a37a00d4559adeedb83",
      "statement": "The RLS helper functions read the same memberships table that the Go authorizer queries, so the database-level and application-level isolation layers cannot disagree about who belongs to which organization.",
      "evidence": [
        {
          "resource": "repo://server/api/authz/simple.go#L49-L64",
