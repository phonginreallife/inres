        }
      ]
    },
    {
      "id": "claim_642f439a5c97482e8cecb0d288f8f069",
      "statement": "Messages can be enqueued with an optional delay through a three-argument pgmq.send, which is the mechanism for scheduling future work such as escalation steps.",
      "evidence": [
