    {
      "id": "claim_533c09f1c63c441e89f7c66312955b1f",
      "statement": "The Go notification worker currently processes only the incident_actions queue, with its incident_notifications and general_notifications processing calls commented out because Slack delivery was delegated to the Python consumer.",
