    },
    {
      "id": "claim_5103a96f02d848e48571aef05c976b9b",
      "statement": "RLS policies restrict each protected table to the caller's organizations, for example allowing selection of an organization row only when its id is among those returned by the user's membership helper.",
      "evidence": [
        {
          "resource": "repo://supabase/migrations/20251202172650_add_rls_policies_for_org_isolation.sql#L60-L70",
          "version": "repo-lines-v1:sha256:e7031e41ba94116657480122c3d008ed7ec4c7418c808bf797644322bbda83f6:"
