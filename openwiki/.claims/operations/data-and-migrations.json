    {
      "id": "claim_de9cd6d954b5462490b62806311c2321",
      "statement": "Queue consumers read with a 30-second visibility timeout and explicitly delete a message after successful processing, so a crashed consumer's message becomes visible again rather than being lost — which makes handler idempotence a requirement.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/notification.go#L218-L232",
          "version": "repo-lines-v1:sha256:6112267140434e2d48c116aad1197a7c823dee2ee049ab0f67d7cd1cf8ff8550:"
