        }
      ]
    },
    {
      "id": "claim_d4a8bc23e3454ffeb79604ae9be6bcdb",
      "statement": "Slack interactions are routed back through a separate incident_actions queue produced by the Slack worker and consumed by the Go notification worker, so that externally triggered actions pass through the proper API layer for consistent business logic instead of the Slack worker mutating incidents directly.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/notification.go#L60-L70",
          "version": "repo-lines-v1:sha256:e2b3e636e673da9254f01acac0fea4890c0abc3803e6ef2398186121921b49c3:"
