        }
      ]
    },
    {
      "id": "claim_0c3e4aa731bb498ea17d9f0f65cd50e0",
      "statement": "The worker runs from the same image as the API, which builds both binaries, with only the container command differing.",
      "evidence": [
        {
          "resource": "repo://deploy/helm/inres/values.yaml#L262-L278",
          "version": "repo-lines-v1:sha256:d3093d265c923fe59d5a45b857e9bd5ac86c1d5942a1e620a1d3bb94de9496f4:"
        }
