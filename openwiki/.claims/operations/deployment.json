    {
      "id": "claim_a46baa351a7a44f1944c3241a7ec9b04",
      "statement": "The migration Job runs as a pre-install and pre-upgrade Helm hook weighted to run before other hooks, is disabled by default for deployments using Supabase-managed migrations, and reads its database and Supabase credentials from the same secret.",
