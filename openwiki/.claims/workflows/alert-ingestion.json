    {
      "id": "claim_a946f12961824a358ab7c55615394d95",
      "statement": "Provider severities are normalized to a shared critical/high/warning/low/info scale, with Grafana alerting states, AWS alarm states and Datadog P1-P5 priorities each mapped onto it and unrecognised values defaulting to warning.",
      "evidence": [
        {
