    },
    {
      "id": "claim_78890b59789243aa99d70e50d2833b4c",
      "statement": "An inverse mapping converts internal severity back into PagerDuty/Datadog style P1-P5 priority, defaulting to P3, so the system can both accept and emit either vocabulary.",
      "evidence": [
        {
          "resource": "repo://server/api/handlers/webhook.go#L1216-L1234",
