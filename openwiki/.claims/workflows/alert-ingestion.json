        }
      ]
    },
    {
      "id": "claim_03c02ddab9024faaa062026fc5ae286d",
      "statement": "Service matching evaluates each connected service integration's routing conditions in order and stops at the first match, so the ordering of service integrations determines which service an alert lands on.",
      "evidence": [
        {
          "resource": "repo://server/api/handlers/webhook.go#L951-L1000",
          "version": "repo-lines-v1:sha256:ede438a0032c00f07b3620d07add98ecc3663d0fb979e2cbe1eb73a1ad4f5b36:"
