    },
    {
      "id": "claim_68a4c64513fd4b4889848b38910cd9db",
      "statement": "Datadog timestamps require dedicated parsing because they arrive as Unix milliseconds encoded in a string rather than as a numeric timestamp.",
      "evidence": [
        {
          "resource": "repo://server/api/handlers/webhook.go#L1178-L1196",
