    {
      "id": "claim_7d9996fc16fe4f56809902a3ee079370",
      "statement": "Resolving an incident from an alert uses a three-strategy fallback chain in descending reliability: exact fingerprint match, then alertname plus instance plus job labels, then a title match explicitly marked as a last resort.",
