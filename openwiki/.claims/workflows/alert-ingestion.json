    {
      "id": "claim_03808cc34f44482aafd83a19bead8a82",
      "statement": "Failure to resolve a service or assignee does not abort incident creation, so an unroutable alert still becomes a visible incident rather than being discarded.",
      "evidence": [
        {
          "resource": "repo://server/api/handlers/webhook.go#L706-L712",
