  "claims": [
    {
      "id": "claim_7f347d0f43ee4b058f7a1043cc29702e",
      "statement": "An incident occupies one of exactly three statuses — triggered, acknowledged or resolved — alongside a low/high urgency, a severity, a P1-P5 priority, an escalation status and level, and an alert count.",
      "evidence": [
        {
          "resource": "repo://server/api/db/incident_models.go#L185-L207",
          "version": "repo-lines-v1:sha256:c063cd75ea198d8cb30afecfd237af0f4a43ef0180412eb3145bd19fa64e5fd2:"
        }
      ]
    },
    {
      "id": "claim_06176ce6d9d14799ba71dcf27369e6a6",
      "statement": "Acknowledgement is guarded in the SQL WHERE clause by requiring the current status to be triggered, so an already-acknowledged or resolved incident cannot be acknowledged again and concurrent acknowledgements cannot both take effect.",
      "evidence": [
        {
          "resource": "repo://server/api/services/incident.go#L985-L996",
          "version": "repo-lines-v1:sha256:49519d6362ccae593d485d57faf2ff7c915f96a903e136a67e6a5295f3bd5960:"
        }
      ]
    },
    {
      "id": "claim_27d06ce7e6bc4f7184d653b4f48af84d",
      "statement": "Resolution is guarded only by requiring the incident not already be resolved, so an incident may be resolved directly from triggered without first being acknowledged.",
      "evidence": [
        {
          "resource": "repo://server/api/services/incident.go#L1020-L1030",
          "version": "repo-lines-v1:sha256:b05d246acc7281a6e1f7b51fa1275b37089d3d0a36d542b9920483555229b1b4:"
        }
      ]
    },
    {
