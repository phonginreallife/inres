  "claims": [
    {
      "id": "claim_c8661a7dec224668a9eedd05418d3656",
      "statement": "EscalationService owns escalation policy and level CRUD, but its alert-driven notification chain is largely unimplemented — notifyCurrentSchedule, notifyUser, notifyGroup, notifyExternal and scheduleNextEscalationStep are TODO stubs that log and return nil, with only notifyScheduler implemented.",
      "evidence": [
        {
          "resource": "repo://server/api/services/escalation.go#L1117-L1200",
          "version": "repo-lines-v1:sha256:93e9dba3e50266383e38385c4de3f3ce70e8605f3914d3e7eae013e30a4c464c:"
        }
      ]
    },
    {
      "id": "claim_d8a609943e8c4ae987523b0f777a4dc5",
      "statement": "The escalation that actually assigns and notifies is the IncidentWorker in internal/background/incident.go, started as a goroutine by both the API server and the standalone worker binary.",
      "evidence": [
        {
          "resource": "repo://server/api/cmd/server/main.go#L118-L130",
          "version": "repo-lines-v1:sha256:79f62f271aeec8226a61980bc420c7df8b065d3d4689d5ee66c4964438cdd901:"
        },
        {
          "resource": "repo://server/api/cmd/worker/main.go#L76-L84",
          "version": "repo-lines-v1:sha256:e9cc43fdb7ff7306f9de1c8567d5b088d84cc6cffe2edcb0794ac1bc69197e11:"
        },
        {
          "resource": "repo://server/api/internal/background/incident.go#L31-L41",
          "version": "repo-lines-v1:sha256:27665d49289758b471024663e36ebf39c4f3cefc566bf61fc7190a0da6cdd15d:"
        }
      ]
    },
    {
      "id": "claim_75af117f00b64e25abf7263d5ca019cc",
      "statement": "The incident worker polls for escalations on a 5-second ticker, though the adjacent comment still claims 30 seconds.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/incident.go#L31-L40",
          "version": "repo-lines-v1:sha256:98a4065cac479a69d94d94d6f70037cf51e4d5a9c65eb8150660df0f1c11fd12:"
        }
      ]
    },
    {
      "id": "claim_5c17c92b5cf947bab3b79af9375f1c7e",
      "statement": "Escalation timeout evaluation happens entirely in SQL: an incident is due when it is triggered, has a policy, has escalation_status of none or pending, and either has never escalated and exceeds level one's timeout or has exceeded its current level's timeout while a next level exists.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/incident.go#L132-L170",
          "version": "repo-lines-v1:sha256:7118c85bc18e20978ea3758c1c89e729ccf5fc0fc262d6ee1b870dd5d657560d:"
        }
      ]
    },
    {
      "id": "claim_7fa32b0ce4274bb5b5a11c39ccbefdbe",
      "statement": "Because timeouts are compared against the database clock with NOW(), worker and database clock skew cannot cause escalations to fire early or late.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/incident.go#L143-L166",
          "version": "repo-lines-v1:sha256:a3372e36fe9111868f5807a30e807f0dab8e3faa21a8bc1f4c32c103c20478de:"
        }
      ]
    },
    {
      "id": "claim_8f304d64dc7740ba808008a52cdab86e",
      "statement": "The escalation selection query requires a next level to exist, so an incident already at its policy's final level is never selected for further escalation.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/incident.go#L155-L166",
          "version": "repo-lines-v1:sha256:759183314dee59715cb2c5a3de0837df7ce89ed747e0a82b07fb0e0c414c1f2c:"
        }
      ]
    },
    {
      "id": "claim_a762b287e1b24ec68cff5118992f08f0",
      "statement": "Incidents due for escalation are claimed with ORDER BY created_at ASC LIMIT 50 FOR UPDATE SKIP LOCKED, which bounds each pass, prioritises the oldest, and lets multiple worker processes run concurrently without double-escalating because each row is claimed by exactly one worker.",
      "evidence": [
        {
          "resource": "repo://deploy/helm/inres/values.yaml#L259-L266",
          "version": "repo-lines-v1:sha256:387794ab43b8d92227c45201ec2284e859e3e01d62762d015f6b4d677e654269:"
        },
        {
          "resource": "repo://server/api/internal/background/incident.go#L165-L172",
          "version": "repo-lines-v1:sha256:91b8c0a8deef3134b5ae54d501d7baa4578f4e314b792e3797103b9ff1341801:"
        }
      ]
    },
    {
      "id": "claim_91eabaa98d564cd38302e29aa7a434f8",
      "statement": "Each due incident is escalated in its own goroutine rather than sequentially.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/incident.go#L62-L67",
          "version": "repo-lines-v1:sha256:2d73377c921273afdcf56be3913a88684858e7f11c9869b0ca110805ea48dbc6:"
        }
      ]
    },
    {
      "id": "claim_dee2d8c057d140bb90ccf32da9744641",
      "statement": "Escalation level zero means not yet escalated, and the chain is marked completed when the policy has no levels, when the next level exceeds the number of defined levels, or when the computed level number is not found among them.",
      "evidence": [
        {
          "resource": "repo://server/api/internal/background/incident.go#L224-L290",
          "version": "repo-lines-v1:sha256:c32b3e4c05051f184a8c665ec9b06d956bb7478f25e898d302158077c26b0e33:"
        }
      ]
    },
    {
      "id": "claim_8a253c007f86416381c6efb4d0f7b57e",
      "statement": "Escalation dispatches on five target types — user, scheduler, current_schedule, group and external — with an unknown type logged and treated as failure.",
