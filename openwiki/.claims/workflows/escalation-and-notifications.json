    {
      "id": "claim_6f78bc692568414fa64336ba87ae7a05",
      "statement": "Escalating to a user assigns the incident with assignment notification suppressed and then sends an escalation notification instead, so the recipient is told the incident was escalated to them rather than merely assigned.",
