    {
      "id": "claim_b49b6a7de4f848319b1be6054e38c258",
      "statement": "On-call scheduling is modelled as groups containing named schedulers, schedulers containing shifts, rotation cycles generating shifts by cycling members, and overrides substituting a different person into a shift.",
