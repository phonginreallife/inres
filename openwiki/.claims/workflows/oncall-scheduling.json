        }
      ]
    },
    {
      "id": "claim_41f3ad57f11e4c2390ff9da6d03b9eaf",
      "statement": "Override resolution lives in the effective_shifts database view rather than in application code, exposing effective_user_id as the coalesce of any override's replacement user over the originally scheduled user.",
