        {
          "resource": "repo://supabase/migrations/20251017163508_create_effective_shifts_view.sql#L70-L76",
          "version": "repo-lines-v1:sha256:1f17da5da38b07644a8f2e6008bd92c456f67e63ece9c71cd9749b2d2036aece:"
        }
      ]
    },
    {
      "id": "claim_5bf24d83e10642ba85a7a6c07b04b967",
      "statement": "The effective shifts view filters to active shifts belonging to active schedulers, so deactivating a scheduler removes its shifts from every on-call answer at once.",
