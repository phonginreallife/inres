        }
      ]
    },
    {
      "id": "claim_82fee63b90fe4c01b6e891ea967a6450",
      "statement": "A Cloudflare API client wraps the full provisioning surface — D1 database creation and SQL execution, Worker upload and deletion, cron trigger creation, KV writes, worker details, metrics and subdomain lookup — so the deployment handler composes those calls rather than speaking HTTP directly.",
