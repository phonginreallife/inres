    {
      "id": "claim_4e6321f1f02d44f59c86b4bac8367162",
      "statement": "Externally synced monitors are scoped to an organization and are merged with self-hosted monitors by a combined listing endpoint, so the dashboard presents one view regardless of where a check actually executes.",
