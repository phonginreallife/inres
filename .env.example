# InRes Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!
#
# For Docker Compose, this file belongs NEXT TO the compose file
# (deploy/docker/.env) - Compose reads .env from the directory containing the
# compose file, not from your shell's working directory.
#
# Values below assume a hosted Supabase project. For a local `supabase start`,
# see the LOCAL SUPABASE section at the bottom instead.

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from https://supabase.com/dashboard/project/{your-project}/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Needed whenever Supabase issues HS256 tokens - which a local `supabase start`
# does. Without it the agent cannot verify the JWT on the chat WebSocket and
# every connection is closed with 4001. Asymmetric (ES256/RS256) tokens are
# verified against JWKS instead and do not need this.
# SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# For local Supabase: postgresql://postgres:postgres@localhost:54322/postgres
# For remote Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# =============================================================================
# AI AGENT (Required for AI features)
# =============================================================================
# The agent drives the Claude Code CLI, so it accepts either credential.
# Set exactly ONE of the two - an API key present anywhere takes precedence
# over an OAuth token, so leave it blank (and blank in the config YAML) when
# you want the subscription.
#
# 1. Metered API key, billed per token: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key

# 2. OAuth token from a Claude Pro/Max subscription. Generate one with
#    `claude setup-token` and paste the result here.
# CLAUDE_CODE_OAUTH_TOKEN=

# =============================================================================
# SLACK INTEGRATION (Optional)
# =============================================================================
# Get these from https://api.slack.com/apps
# Required for Slack notifications and interactive messages

# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_SIGNING_SECRET=your-signing-secret

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# API server port
PORT=8080

# AI agent port
AI_PORT=8002

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Public API URL (for webhooks and external access)
PUBLIC_URL=http://localhost:8080

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Redis URL (optional - for caching and rate limiting)
# REDIS_URL=redis://localhost:6379

# FCM credentials path (optional - for mobile push notifications)
# FCM_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Notification Gateway (optional - for Cloudflare Worker push notifications)
# NOTIFICATION_GATEWAY_URL=https://your-worker.workers.dev
# NOTIFICATION_GATEWAY_INSTANCE_ID=inst_xxx
# NOTIFICATION_GATEWAY_API_TOKEN=inres_tok_xxx

# =============================================================================
# LOCAL SUPABASE (supabase start)
# =============================================================================
# `supabase status` prints the URL, anon key, service_role key and JWT secret
# for your local stack - use those values, not the hosted ones above.
#
# Container and network names are derived from project_id in
# supabase/config.toml, which is "inres-oss" in this repo. Confirm with
# `docker network ls` and `docker ps` before relying on these.
#
# From the HOST (frontend dev server, psql, curl):
#   SUPABASE_URL=http://127.0.0.1:54321
#   DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
#
# From INSIDE the compose network (the agent and api containers) - they reach
# Supabase by container name, so the host ports do not apply:
# SUPABASE_NETWORK=supabase_network_inres-oss
# SUPABASE_URL=http://supabase_kong_inres-oss:8000
# DATABASE_URL=postgresql://postgres:postgres@supabase_db_inres-oss:5432/postgres?sslmode=disable
