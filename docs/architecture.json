  "cards": [
    {
      "dot": "cyan",
      "title": "Request paths",
      "items": [
        "Kong :8000 is the only ingress, so UI and WebSocket share one origin",
        "Alerts arrive at /webhook, route against the on-call schedule, then notify",
        "Chat runs over /ws/chat and streams tokens as the CLI generates them"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent session",
      "items": [
        "One SDK client stays connected for the life of the WebSocket",
        "Context survives between turns and resumes from the CLI transcript",
        "Conversations persist to Postgres; tools need approval unless allow-listed"
      ]
    },
    {
      "dot": "amber",
      "title": "Operational limits",
      "items": [
        "The agent must stay at 1 replica - RWO volumes and pod-local session state",
        "api and web are stateless behind Kong and scale horizontally",
        "Losing the PVCs costs conversation context, not conversation history"
      ]
    }
  ]
